<?php

declare(strict_types=1);
/** @var CompactMediaCardsExtension $this */

$actions = CompactMediaCardsExtension::swipeActionOptions();
$leftAction = $this->getSwipeLeftAction();
$rightAction = $this->getSwipeRightAction();
?>

<h2>Compact Media Cards</h2>

<form action="<?= _url('extension', 'configure', 'e', urlencode($this->getName())) ?>" method="post" data-auto-leave-validation="1">
	<input type="hidden" name="_csrf" value="<?= FreshRSS_Auth::csrfToken() ?>" />

	<div class="form-group">
		<label class="group-name" for="cmc_swipe_left_action">Swipe left <small>(drag right-to-left)</small></label>
		<div class="group-controls">
			<select id="cmc_swipe_left_action" name="cmc_swipe_left_action">
				<?php foreach ($actions as $value => $label): ?>
					<option value="<?= htmlspecialchars($value, ENT_QUOTES, 'UTF-8') ?>"<?= $leftAction === $value ? ' selected="selected"' : '' ?>><?= htmlspecialchars($label, ENT_QUOTES, 'UTF-8') ?></option>
				<?php endforeach; ?>
			</select>
		</div>
	</div>

	<div class="form-group">
		<label class="group-name" for="cmc_swipe_right_action">Swipe right <small>(drag left-to-right)</small></label>
		<div class="group-controls">
			<select id="cmc_swipe_right_action" name="cmc_swipe_right_action">
				<?php foreach ($actions as $value => $label): ?>
					<option value="<?= htmlspecialchars($value, ENT_QUOTES, 'UTF-8') ?>"<?= $rightAction === $value ? ' selected="selected"' : '' ?>><?= htmlspecialchars($label, ENT_QUOTES, 'UTF-8') ?></option>
				<?php endforeach; ?>
			</select>
		</div>
	</div>

	<p class="help">
		Karakeep uses the existing Karakeep Button extension and must remain enabled. A disabled or unavailable action gently resists the swipe and does nothing.
	</p>

	<div class="form-group form-actions">
		<div class="group-controls">
			<button type="submit" class="btn btn-important">Save swipe actions</button>
		</div>
	</div>
</form>
