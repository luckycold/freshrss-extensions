<?php
	$locks = $this->activeLocks();
	$feedback = $this->retryFeedback();
?>

<h2><?= _t('ext.retry_after_manager.title') ?></h2>
<p class="help"><?= _t('ext.retry_after_manager.help') ?></p>

<?php if (is_array($feedback)): ?>
	<?php
		$status = in_array($feedback['status'], ['success', 'warning', 'error', 'info'], true) ? $feedback['status'] : 'info';
		$message = _t('ext.retry_after_manager.' . $feedback['message']);
		if (isset($feedback['new_articles'])) {
			$message .= ' ' . _t('ext.retry_after_manager.new_articles', $feedback['new_articles']);
		}
	?>
	<p class="alert alert-<?= htmlspecialchars($status, ENT_QUOTES, 'UTF-8') ?>"><?= htmlspecialchars($message, ENT_QUOTES, 'UTF-8') ?></p>
<?php endif; ?>

<?php if ($locks === []): ?>
	<p class="alert alert-success"><?= _t('ext.retry_after_manager.none') ?></p>
<?php else: ?>
	<table class="table-striped">
		<thead>
			<tr>
				<th><?= _t('ext.retry_after_manager.feed') ?></th>
				<th><?= _t('ext.retry_after_manager.source') ?></th>
				<th><?= _t('ext.retry_after_manager.scope') ?></th>
				<th><?= _t('ext.retry_after_manager.expires') ?></th>
				<th><?= _t('ext.retry_after_manager.action') ?></th>
			</tr>
		</thead>
		<tbody>
		<?php foreach ($locks as $lock): ?>
			<tr>
				<td><?= htmlspecialchars($lock['name'], ENT_QUOTES, 'UTF-8') ?></td>
				<td><code><?= htmlspecialchars($lock['host'] . $lock['path'], ENT_QUOTES, 'UTF-8') ?></code></td>
				<td><?= _t('ext.retry_after_manager.scope_' . $lock['scope']) ?></td>
				<td><time datetime="<?= date(DATE_ATOM, $lock['expires']) ?>"><?= htmlspecialchars(date('Y-m-d H:i:s T', $lock['expires']), ENT_QUOTES, 'UTF-8') ?></time></td>
				<td>
					<form action="<?= _url('extension', 'configure', 'e', urlencode($this->getName())) ?>" method="post">
						<input type="hidden" name="_csrf" value="<?= FreshRSS_Auth::csrfToken() ?>" />
						<input type="hidden" name="retry_after_action" value="reset" />
						<input type="hidden" name="retry_after_feed_id" value="<?= (int) $lock['id'] ?>" />
						<button type="submit" class="btn btn-important"><?= _t('ext.retry_after_manager.reset_refresh') ?></button>
					</form>
				</td>
			</tr>
		<?php endforeach; ?>
		</tbody>
	</table>
	<p class="help"><?= _t('ext.retry_after_manager.scope_help') ?></p>
<?php endif; ?>
